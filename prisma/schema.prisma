// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_PRISMA_URL")
  // directUrl = env("DATABASE_URL_NON_POOLING")
}

enum UserRole {
  USER
  ADMIN
}

enum DifficultyChoice {
  BOOST
  NORMAL
  EASY
}

enum SorenessIntensity {
  NONE
  LIGHT
  MODERATE
  SEVERE
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  role          UserRole   @default(USER)
  password      String?
  UserInfo      UserInfo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ActionMass      ActionMass[]
  ActionLoss      ActionLoss[]
  ActionStrength  ActionStrength[]
  ApproachesGroup ApproachesGroup[]

  Training                      Training[]
  TrainingExerciseScore         TrainingExerciseScore[]
  TrainingPeriod                TrainingPeriod[]
  ProgressionStrategySimpleOpts ProgressionStrategySimpleOpts[]
  PersonalRecords               PersonalRecord[]

  Equipment Equipment[]

  Checkup Checkup[]

  MuscleSoreness MuscleSoreness[]

  TrainingMuscleLoad TrainingMuscleLoad[]
}

model Equipment {
  id Int @id @default(autoincrement())

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Requires EquipmentRequire[]
  Rigs     EquipmentRig[]

  Trainings Training[]

  // У пользователя не более одного дефолтного набора — проверка в сервисном слое (см. handleEquipmentSave)
  @@index([userId])
}

model EquipmentRequire {
  id          Int       @id @default(autoincrement())
  equipmentId Int
  Equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  type ActionRequire

  @@unique([equipmentId, type])
}

model EquipmentRig {
  id          Int       @id @default(autoincrement())
  equipmentId Int
  Equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  type      ActionRig
  minWeight Decimal   @default(5) @db.Decimal(5, 2)
  step      Decimal   @default(2.5) @db.Decimal(4, 2)
  maxWeight Decimal   @default(200) @db.Decimal(5, 2)

  @@unique([equipmentId, type])
}

enum TrainingProgression {
  NONE
  SIMPLE
}

enum Sex {
  MALE
  FEMALE
}

enum TrainingExperience {
  NONE           // нет опыта
  LESS_THAN_1    // менее 1 года
  ONE_TO_TWO     // 1-2 года
  THREE_TO_FIVE  // 3-5 лет
  MORE_THAN_FIVE // более 5 лет
}

model UserInfo {
  id     Int    @id @default(autoincrement())
  userId String

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sex                       Sex                 @default(MALE)
  height                    Int                 @default(175)
  purpose                   Purpose             @default(STRENGTH)
  trainingProgression       TrainingProgression @default(NONE)
  trainingProgressionParams Json                @default("{}")

  // Onboarding
  trainingExperience  TrainingExperience?
  onboardingCompleted Boolean             @default(false)

  // Settings
  collectExerciseExecutionFeedback Boolean @default(false)

  // Checkups
  checkupsEnabled Boolean @default(true)
  isEmployed      Boolean @default(false)

  // Soreness tracking
  sorenessEnabled Boolean @default(true)
}

model Account {
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  refresh_token_expires_in Int?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model MuscleGroup {
  id Int @id @default(autoincrement())

  title           String
  Muscle          Muscle[]
  MuscleGroupDesc MuscleGroupDesc[]

  TrainingMuscleStat TrainingMuscleStat[]

  TrainingMuscleLoad TrainingMuscleLoad[]
}

model MuscleGroupDesc {
  id        Int         @id @default(autoincrement())
  groupId   Int
  Group     MuscleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  text      String
  link      String
  createdAt DateTime    @default(now())
}

model Muscle {
  id Int @id @default(autoincrement())

  title   String
  titleEn String?

  // Ценность мышцы как самостоятельной цели тренировки внутри её группы:
  // 3 — крупная главная цель; 2 — значимая вспомогательная; 1 — мелкие/стабилизаторы/добивка
  priorityRank Int @default(1)

  // Относительный размер и системная нагрузка (1.0 = большая группа, 0.3 = глубокий мелкий стабилизатор)
  sizeFactor Float @default(0.5)

  groupId Int
  Group   MuscleGroup @relation(fields: [groupId], references: [id])

  AgonyInActions      ActionsOnMusclesAgony[]
  SynergyInActions    ActionsOnMusclesSynergy[]
  StabilizerInActions ActionsOnMusclesStabilizer[]
  AntagonistInActions ActionsOnMusclesAntagonist[]

  TrainingMuscleStat TrainingMuscleStat[]

  MuscleDesc MuscleDesc[]

  MuscleImages MuscleImage[]

  MuscleSorenessEntry MuscleSorenessEntry[]
}

model MuscleDesc {
  id        Int      @id @default(autoincrement())
  muscleId  Int
  Muscle    Muscle   @relation(fields: [muscleId], references: [id], onDelete: Cascade)
  text      String
  link      String
  createdAt DateTime @default(now())
}

model ActionsOnMusclesAgony {
  muscleId Int
  Muscle   Muscle @relation(fields: [muscleId], references: [id])

  actionId Int
  Action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@id([actionId, muscleId])
}

model ActionsOnMusclesSynergy {
  muscleId Int
  Muscle   Muscle @relation(fields: [muscleId], references: [id])

  actionId Int
  Action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@id([actionId, muscleId])
}

model ActionsOnMusclesStabilizer {
  muscleId Int
  Muscle   Muscle @relation(fields: [muscleId], references: [id])

  actionId Int
  Action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@id([actionId, muscleId])
}

model ActionsOnMusclesAntagonist {
  muscleId Int
  Muscle   Muscle @relation(fields: [muscleId], references: [id])

  actionId Int
  Action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@id([actionId, muscleId])
}

model Action {
  id Int @id @default(autoincrement())

  title            String
  desc             String
  alias            String?
  anotherTitles    String?
  search           String? @db.Text
  isMarkDownInDesc Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  bigCount      Boolean @default(false)
  allowCheating Boolean @default(false)
  oneDumbbell   Boolean @default(false)

  // Упражнения «на длительность» (беговая дорожка, планка, вело): без веса и повторов,
  // только длительность и опциональный числовой параметр сложности. Длительность хранится
  // в Approach.count (секунды), параметр — в Approach.weight. Цель выполнения всегда LOSS.
  isDurationBased    Boolean @default(false)
  durationParamLabel String? // напр. «Скорость», «Наклон», «Уровень»; null — параметра нет
  durationParamUnit  String? // напр. «км/ч», «%», «уровень»

  // Базовость упражнения: 0.7 * сумма sizeFactor агонистов + 0.3 * сумма sizeFactor синергистов
  base Float @default(0)

  MusclesAgony      ActionsOnMusclesAgony[]
  MusclesSynergy    ActionsOnMusclesSynergy[]
  MusclesStabilizer ActionsOnMusclesStabilizer[]
  MusclesAntagonist ActionsOnMusclesAntagonist[]

  rig     ActionRig     @default(OTHER)
  require ActionRequire @default(NONE)

  ActionMass     ActionMass[]
  ActionLoss     ActionLoss[]
  ActionStrength ActionStrength[]

  ApproachesGroup ApproachesGroup[]

  TrainingExercise      TrainingExercise[]
  TrainingExerciseScore TrainingExerciseScore[]
  PersonalRecords       PersonalRecord[]

  ExerciseImages ExerciseImage[]

  // Similar exercises relationships
  SimilarTo   SimilarExercises[] @relation("SimilarToExercise")
  SimilarFrom SimilarExercises[] @relation("SimilarFromExercise")

  @@index([search(ops: raw("gin_trgm_ops"))], type: Gin, map: "Action_search_trgm_idx")
}

model ActionMass {
  id Int @id @default(autoincrement())

  currentApproachGroupId Int
  CurrentApproachGroup   ApproachesGroup @relation(fields: [currentApproachGroupId], references: [id], onDelete: Cascade)

  actionId Int
  Action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActionStrength {
  id Int @id @default(autoincrement())

  currentApproachGroupId Int
  CurrentApproachGroup   ApproachesGroup @relation(fields: [currentApproachGroupId], references: [id], onDelete: Cascade)

  actionId Int
  Action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActionLoss {
  id Int @id @default(autoincrement())

  currentApproachGroupId Int
  CurrentApproachGroup   ApproachesGroup @relation(fields: [currentApproachGroupId], references: [id], onDelete: Cascade)

  actionId Int
  Action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApproachesGroup {
  id Int @id @default(autoincrement())

  createdAt DateTime @default(now())

  // см. SetsStats

  // кол-во подходов
  count Int @default(0)

  // статистики по весам
  sum  Float @default(0)
  mean Float @default(0)
  max  Float @default(0)

  // статистики по кол-вам
  countTotal Int   @default(0)
  countMean  Float @default(0)

  ActionMass     ActionMass[]
  ActionStrength ActionStrength[]

  Approaches       Approach[]
  TrainingExercise TrainingExercise[]

  actionId Int
  Action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  userId     String
  User       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ActionLoss ActionLoss[]
}

model Approach {
  id Int @id @default(autoincrement())

  priority Int     @default(0)
  weight   Float
  count    Int
  isBoost  Boolean @default(false)

  groupId                   Int
  Group                     ApproachesGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  TrainingExerciseExecution TrainingExerciseExecution[]
}

enum Purpose {
  MASS
  STRENGTH
  LOSS
}

model Training {
  id Int @id @default(autoincrement())

  createdAt        DateTime           @default(now())
  plannedTo        DateTime
  startedAt        DateTime?
  completedAt      DateTime?
  processedAt      DateTime?
  TrainingExercise TrainingExercise[]

  userId String
  User   User   @relation(references: [id], fields: [userId], onDelete: Cascade)

  periodId Int?
  Period   TrainingPeriod? @relation(fields: [periodId], references: [id])

  // link to the original training if this one is a repeat
  repeatedFromId Int?
  RepeatedFrom   Training?  @relation("TrainingRepeatedFrom", fields: [repeatedFromId], references: [id])
  Repeats        Training[] @relation("TrainingRepeatedFrom")

  isCircuit     Boolean @default(false)
  commonComment String?

  equipmentId Int?
  Equipment   Equipment? @relation(fields: [equipmentId], references: [id])

  completeComment String?

  // Feedback control: when true, user won't be asked for execution feedback
  noFeedback Boolean @default(false)

  timeScoreInMins Float     @default(0)
  timeScoreInSecs String?
  timeScoredAt    DateTime?

  difficultyScore Float @default(0)

  // Сложность по фактическим подъёмам (те же формулы, что и для плановой).
  // 0 означает «данных о выполнении нет», а не «тренировка была лёгкой».
  executedDifficultyScore Float @default(0)

  // Подпись тренировки по agonist-группам мышц: связывает между собой тренировки «про одно и то же»
  muscleSignature String?

  ExerciseExecutionDuration TrainingExerciseExecutionDuration[]

  TrainingMuscleStat TrainingMuscleStat[]

  MuscleLoad TrainingMuscleLoad[]

  PersonalRecords PersonalRecord[]

  noWarmUp Boolean         @default(false)
  WarmUp   TrainingWarmUp?

  externalId       String?
  syncedFromMobile Boolean @default(false)

  Checkup Checkup?

  MuscleSoreness MuscleSoreness?

  @@unique([userId, externalId])
  @@index([userId, muscleSignature, plannedTo])
}

model TrainingExercise {
  id Int @id @default(autoincrement())

  trainingId Int
  Training   Training @relation(references: [id], fields: [trainingId], onDelete: Cascade)

  priority Int @default(0)

  approachGroupId Int
  ApproachGroup   ApproachesGroup @relation(references: [id], fields: [approachGroupId], onDelete: Cascade)

  startedAt                 DateTime?
  completedAt               DateTime?
  TrainingExerciseExecution TrainingExerciseExecution[]

  purpose   Purpose
  purposeId Int // ActionMass.id | ActionStrength.id | ActionLoss.id

  actionId Int
  Action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  isPassed Boolean @default(false)

  liftedSum        Int   @default(0)
  liftedMean       Float @default(0)
  liftedMax        Float @default(0)
  liftedCountTotal Int   @default(0)
  liftedCountMean  Float @default(0)

  rating  TrainingRating @default(OK)
  comment String?

  difficultyScore Float @default(0)

  Score TrainingExerciseScore[]

  PersonalRecords PersonalRecord[]

  ExecutionDuration TrainingExerciseExecutionDuration[]
}

enum TrainingRating {
  EASY
  OK
  HARD
  IMPOSSIBLE
}

model TrainingExerciseExecution {
  id Int @id @default(autoincrement())

  exerciseId Int
  Exercise   TrainingExercise @relation(references: [id], fields: [exerciseId], onDelete: Cascade)

  approachId Int?
  Approach   Approach? @relation(references: [id], fields: [approachId], onDelete: Cascade)

  plannedWeigth Float
  plannedCount  Int
  liftedWeight  Float
  liftedCount   Int

  executedAt DateTime?
  isPassed   Boolean   @default(false)
  priority   Int       @default(0)

  rating    ExecutionRating    @default(OK)
  technique ExecutionTechnique @default(OK)
  cheating  ExecutionCheating  @default(NO)
  refusing  ExecutionRefusing  @default(NO)
  burning   ExecutionBurning   @default(NO)

  comment String?

  techniqueUpgrade Boolean @default(false)

  useBelt Boolean @default(false)

  extraCount Int @default(0)

  // durations
  Duration TrainingExerciseExecutionDuration[]
}

// см. RatingOptions
enum ExecutionRating {
  EASY
  OK
  TENSION_OK // deprecated
  TENSION_FLAW // deprecated
  TENSION
  HARD
}

enum ExecutionTechnique {
  OK
  FLAW
}

// см. CheatingOptions
enum ExecutionCheating {
  NO
  PART
  FULL
}

// см. RefusingOptions
enum ExecutionRefusing {
  NO
  SOON
  YES
}

// см. BurningOptions
enum ExecutionBurning {
  NO
  YES
}

enum ActionRig {
  BLOCKS // блоки/блины в тренажерах
  BARBELL // штанга
  DUMBBELL // гантели
  KETTLEBELL // гиря
  OTHER // с собственным весом
}

enum ActionRequire {
  NONE // ничего
  UPBAR // турник, брусья
  BENCH // какая-то скамья, todo разнести на разные
  SIMULATOR // какой-то тренажер, todo разнести на разные
}

model Weight {
  id        Int      @id @default(autoincrement())
  userId    String
  createdAt DateTime @default(now())
  value     Float

  @@index([userId, createdAt])
}

model TrainingExerciseScore {
  id        Int      @id @default(autoincrement())
  createdAt DateTime
  userId    String
  actionId  Int
  purpose   Purpose

  trainingExerciseId Int  @default(0)
  coefficients       Json @default("{}")

  liftedSumNorm        Float @default(0)
  liftedMeanNorm       Float @default(0)
  liftedMaxNorm        Float @default(0)
  liftedCountTotalNorm Float @default(0)
  liftedCountMeanNorm  Float @default(0)
  score                Float @default(0)

  User     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  Action   Action           @relation(fields: [actionId], references: [id], onDelete: Cascade)
  Exercise TrainingExercise @relation(fields: [trainingExerciseId], references: [id], onDelete: Cascade)

  @@index([userId, actionId, purpose, createdAt])
}

enum PersonalRecordType {
  MAX_WEIGHT // максимальный вес одного подхода
  MAX_VOLUME // тоннаж: сумма вес × повторы за упражнение
}

// Персональный рекорд пользователя по упражнению в разрезе цели.
// Производные данные: пересчитываются при обработке тренировки и скриптом бэкфилла.
// Запись с previousValue = null — «база» (первый результат в истории или в периоде), на UI не показывается.
model PersonalRecord {
  id Int @id @default(autoincrement())

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  actionId Int
  Action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  purpose Purpose
  type    PersonalRecordType

  // абсолютный рекорд за всё время или лучший результат текущего периода
  isAllTime Boolean

  value Float
  // повторы рекордного подхода — только для MAX_WEIGHT (показ «100 × 5»)
  reps  Int?

  trainingId Int
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  trainingExerciseId Int
  Exercise           TrainingExercise @relation(fields: [trainingExerciseId], references: [id], onDelete: Cascade)

  // период, в рамках которого зафиксирован периодический рекорд; null для all-time записей тренировок без периода
  periodId Int?
  Period   TrainingPeriod? @relation(fields: [periodId], references: [id])

  achievedAt DateTime // = Training.completedAt

  // прежний лучший результат той же связки на момент фиксации (исторический снапшот)
  previousValue      Float?
  previousTrainingId Int?
  previousAt         DateTime?

  createdAt DateTime @default(now())

  // поиск последнего рекорда пользователя по упражнению
  @@index([userId, actionId, purpose, type, achievedAt(sort: Desc)])
  // рекорды конкретной тренировки (страница тренировки, блок на главной)
  @@index([userId, trainingId])
  // списки рекордов (главная, страница «Рекорды»)
  @@index([userId, achievedAt(sort: Desc)])
}

model TrainingPeriod {
  id        Int       @id @default(autoincrement())
  startDate DateTime  @default(now())
  endDate   DateTime?
  isCurrent Boolean   @default(true)

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  Trainings                     Training[]
  ProgressionStrategySimpleOpts ProgressionStrategySimpleOpts?
  PersonalRecords               PersonalRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isCurrent])
}

model ProgressionStrategySimpleOpts {
  id Int @id @default(autoincrement())

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trainingPeriodId Int            @unique
  TrainingPeriod   TrainingPeriod @relation(fields: [trainingPeriodId], references: [id], onDelete: Cascade)

  // шаг блинов/дисков в тренажёрах, к которому округляются веса
  equipmentStep Float @default(2.5)

  strengthWorkingSetsCount Int   @default(4)
  strengthPrepareSetsCount Int   @default(2)
  strengthWeightDelta      Float @default(5)
  // порог повторов, при котором лестница strength перестраивается вверх
  strengthRepThreshold       Int   @default(3)

  massSetsCount    Int     @default(4)
  massBigCountCoef Float   @default(1.8)
  massWeightDelta  Float   @default(2.5)
  massAddDropSet   Boolean @default(true)

  lossCountStep   Int   @default(2)
  lossCountMax    Int   @default(16)
  lossWeightDelta Float @default(1.25)
  lossMaxSets     Int   @default(6)

  // множитель отката при достижении потолка (loss: сброс mean, duration: сброс sec)
  resetMultiplier Int @default(2)

  // упражнения «на длительность» (isDurationBased): секунды в count, параметр в weight
  durationSetsCount Int   @default(1)
  durationStepSec   Int   @default(30)
  durationMaxSec    Int   @default(600)
  durationParamStep Float @default(1)
  durationMaxSets   Int   @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExerciseImage {
  id Int @id @default(autoincrement())

  filename String
  path     String
  size     Int
  format   String
  isMain   Boolean @default(false)

  actionId Int
  Action   Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MuscleImage {
  id Int @id @default(autoincrement())

  filename String
  path     String
  size     Int
  format   String
  isMain   Boolean @default(false)

  muscleId Int
  Muscle   Muscle @relation(fields: [muscleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingMuscleStat {
  id Int @id @default(autoincrement())

  trainingId Int
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  muscleId Int
  Muscle   Muscle @relation(fields: [muscleId], references: [id])

  muscleGroupId Int
  MuscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id])

  asAgonyCnt  Int @default(0)
  asSynerCnt  Int @default(0)
  asStableCnt Int @default(0)

  @@unique([trainingId, muscleId])
  @@index([trainingId])
}

// Нагрузка на группу мышц в конкретной тренировке — основа «нити» динамики.
// Сумма plannedLoad по группам равна Training.difficultyScore, сумма executedLoad —
// Training.executedDifficultyScore: графики нити и линии процесса сходятся в одно число.
model TrainingMuscleLoad {
  id Int @id @default(autoincrement())

  trainingId Int
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  muscleGroupId Int
  MuscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id])

  // денормализация: недельные агрегации фильтруются по пользователю без join с Training
  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plannedLoad  Float @default(0)
  executedLoad Float @default(0)

  // сколько упражнений тренировало группу в этой роли — для подписей и отладки
  agonyCnt   Int @default(0)
  synergyCnt Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trainingId, muscleGroupId])
  @@index([userId, muscleGroupId])
}

model SimilarExercises {
  id Int @id @default(autoincrement())

  actionId Int
  Action   Action @relation("SimilarFromExercise", fields: [actionId], references: [id], onDelete: Cascade)

  similarActionId Int
  SimilarAction   Action @relation("SimilarToExercise", fields: [similarActionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([actionId, similarActionId])
}

model TrainingExerciseExecutionDuration {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  trainingId Int
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  trainingExerciseId Int
  TrainingExercise   TrainingExercise @relation(fields: [trainingExerciseId], references: [id], onDelete: Cascade)

  executionId Int                       @unique
  Execution   TrainingExerciseExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  sequence Int
  seconds  Int

  @@index([trainingId, sequence])
  @@index([trainingId, trainingExerciseId])
}

model TrainingWarmUp {
  id Int @id @default(autoincrement())

  trainingId Int      @unique
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  estimatedTimeSec Int @default(300)

  startedAt   DateTime?
  isSkipped   Boolean   @default(false)
  completedAt DateTime?
  durationSec Int?
}

model Checkup {
  id Int @id @default(autoincrement())

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trainingId Int       @unique
  Training   Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  // Basic wellness (1–5)
  sleep     Int
  nutrition Int
  preWorkout Int
  stress    Int

  // BAT-4 burnout screening (1–5, nullable — skipped if user is not employed)
  burnoutExhaustion Int?
  burnoutDistance   Int?
  burnoutCognitive  Int?
  burnoutEmotional  Int?
  burnoutScore      Float?

  // User's difficulty decision
  difficultyChoice DifficultyChoice?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model MuscleSoreness {
  id Int @id @default(autoincrement())

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trainingId Int      @unique
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  daysAfter Int

  createdAt DateTime @default(now())

  Entries MuscleSorenessEntry[]

  @@index([userId, createdAt])
}

model MuscleSorenessEntry {
  id Int @id @default(autoincrement())

  sorenessId Int
  Soreness   MuscleSoreness @relation(fields: [sorenessId], references: [id], onDelete: Cascade)

  muscleId  Int
  Muscle    Muscle @relation(fields: [muscleId], references: [id])

  intensity SorenessIntensity @default(NONE)

  @@unique([sorenessId, muscleId])
}
